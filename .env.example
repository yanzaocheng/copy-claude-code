# Optional gateway configuration. /login normally saves the key in
# ~/.claude-pro/gateway.json, so CLAUDE_PRO_GATEWAY_API_KEY is only needed for
# headless or automated runs.
CLAUDE_PRO_PROVIDER=gateway
CLAUDE_PRO_GATEWAY_URL=https://gw.predix.icu
CLAUDE_PRO_GATEWAY_API_KEY=gw-your-key
CLAUDE_PRO_GATEWAY_MODEL=opus

# Reasoning and context tuning
# CLAUDE_CODE_EFFORT_LEVEL=high               # default: the model's own
# CLAUDE_CODE_AUTO_COMPACT_WINDOW=250000      # default: the model's whole window
# CLAUDE_CODE_MAX_OUTPUT_TOKENS=48000         # gateway default
# MAX_THINKING_TOKENS=0                       # 0 = disable thinking
# CLAUDE_CODE_PROMPT_CACHE_TTL=1h             # 5m or 1h for the main conversation
# CLAUDE_CODE_SUBAGENT_PROMPT_CACHE_TTL=5m    # sub-agents, compaction and side queries
# ENABLE_PROMPT_CACHING_1H=1                 # 1h for both buckets
# FORCE_PROMPT_CACHING_5M=1                   # force 5m for both buckets
# DISABLE_PROMPT_CACHING=1                    # send no cache_control markers
# CLAUDE_AUTOCOMPACT_PCT_OVERRIDE=90
# DISABLE_AUTOCOMPACT=1

# Request and tool limits
# API_TIMEOUT_MS=600000
# CLAUDE_PRO_MAX_RETRIES=6
# CLAUDE_PRO_RATE_LIMIT_MAX_WAIT_MS=21600000  # 0 = fail instead of waiting
# BASH_DEFAULT_TIMEOUT_MS=600000
# BASH_MAX_TIMEOUT_MS=3600000
# BASH_MAX_OUTPUT_LENGTH=60000
# CLAUDE_CODE_GIT_BASH_PATH=C:\Program Files\Git\bin\bash.exe
