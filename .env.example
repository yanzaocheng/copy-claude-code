# Copy to .env and fill in. Same variable names as Claude Code.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=sk-your-key
ANTHROPIC_MODEL=deepseek-flash[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-flash[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-flash[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-flash
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-flash
CLAUDE_CODE_EFFORT_LEVEL=max
CLAUDE_CODE_AUTO_COMPACT_WINDOW=786432

# Optional
# CLAUDE_PRO_PROVIDER=claude-code  # Direct HTTP with existing local Claude Code OAuth login
# CLAUDE_PRO_CLAUDE_CODE_MODEL=sonnet
# CLAUDE_PRO_CLAUDE_CONFIG_FILE=C:\Users\you\.claude.json
# CLAUDE_PRO_CLAUDE_CREDENTIALS_FILE=C:\Users\you\.claude\.credentials.json
# CLAUDE_PRO_CLAUDE_CODE_VERSION=2.1.289
# CLAUDE_CONFIG_DIR=C:\Users\you\.claude
# CLAUDE_PRO_DISABLE_TOPIC_TITLE=1      # tab title: keep the first message instead of the current topic (no small-model request per message)
# CLAUDE_PRO_AUTO_RESTART=0            # do not restart by itself when claude-pro's own source changed (/restart still works)
# CLAUDE_PRO_DISABLE_TOKEN_REFRESH=1  # claude-code provider: do not renew the expired login by itself
# CLAUDE_CODE_MAX_OUTPUT_TOKENS=32000
# MAX_THINKING_TOKENS=0            # 0 = disable thinking
# CLAUDE_CODE_PROMPT_CACHE_TTL=1h              # prompt cache TTL of the conversation: 5m (default) or 1h (writes cost 2x; worth it when you often pause for more than 5 minutes)
# CLAUDE_CODE_SUBAGENT_PROMPT_CACHE_TTL=5m     # ... of sub-agents, compaction and side queries
# ENABLE_PROMPT_CACHING_1H=1                   # 1h for both (the two variables above win); FORCE_PROMPT_CACHING_5M=1 forces 5m for both
# DISABLE_PROMPT_CACHING=1                     # send no cache_control at all (DISABLE_PROMPT_CACHING_HAIKU / _SONNET / _OPUS / _FABLE: one model only)
# CLAUDE_AUTOCOMPACT_PCT_OVERRIDE=90
# DISABLE_AUTOCOMPACT=1
# API_TIMEOUT_MS=600000
# CLAUDE_PRO_RATE_LIMIT_MAX_WAIT_MS=21600000  # longest wait for a rate limit (5-hour window) to reset; 0 = fail instead of waiting
# CLAUDE_PRO_RATE_LIMIT_POLL_MS=300000        # when the reset time is unknown, retry at most this far apart
# BASH_DEFAULT_TIMEOUT_MS=120000
# BASH_MAX_TIMEOUT_MS=600000
# BASH_MAX_OUTPUT_LENGTH=30000
# CLAUDE_CODE_GIT_BASH_PATH=C:\Program Files\Git\bin\bash.exe
