  "description": "claude-pro: a command line coding agent for the codex-gateway. Full access with no permission prompts; file edits are checkpointed and can be rewound.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanzaocheng/copy-claude-code.git"
  },
