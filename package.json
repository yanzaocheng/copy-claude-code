{
  "name": "@yanzc/claude-pro",
  "version": "0.19.0",
  "description": "claude-pro: a command line coding agent for many model providers (Anthropic, OpenAI, DeepSeek, Kimi, GLM, Qwen, OpenRouter, the 7bit.fun gateway, your own endpoint...). Full access with no permission prompts; file edits are checkpointed and can be rewound.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanzaocheng/copy-claude-code.git"
  },
  "homepage": "https://github.com/yanzaocheng/copy-claude-code#readme",
  "keywords": [
    "claude",
    "coding-agent",
    "cli",
    "anthropic",
    "openai",
    "deepseek",
    "multi-provider",
    "ai"
  ],
  "bin": {
    "claude-pro": "bin/claude-pro.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/claude-pro.js",
    "check": "node bin/claude-pro.js --self-check",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@lydell/node-pty": "1.2.0-beta.18",
    "@noble/curves": "^2.4.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.13.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2"
  }
}
