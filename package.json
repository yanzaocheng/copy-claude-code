{
  "name": "@yanzc/claude-pro",
  "version": "0.5.8",
  "description": "claude-pro: a self-implemented coding agent for Anthropic-compatible APIs or local Claude Code subscription login. Full access with no permission prompts; file edits are checkpointed and can be rewound.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanzaocheng/copy-claude-code.git"
  },
  "homepage": "https://github.com/yanzaocheng/copy-claude-code#readme",
  "keywords": [
    "claude",
    "coding-agent",
    "cli",
    "anthropic",
    "ai"
  ],
  "bin": {
    "claude-pro": "bin/claude-pro.js"
  },
  "files": [
    "bin/",
    "src/",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/claude-pro.js",
    "check": "node bin/claude-pro.js --self-check",
    "test": "node --test --test-force-exit --test-timeout=60000 --test-reporter=dot \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0"
  },
  "devDependencies": {
    "@xterm/headless": "^6.0.0"
  }
}
